<ContentPage x:Class="StarterApp.Views.ItemPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StarterApp.ViewModels"
             Title="{Binding Title}">

    <VerticalStackLayout>

        <!-- Tab buttons -->
        <HorizontalStackLayout Spacing="10" Padding="10">
            <Button Text="Browse" Clicked="OnBrowseClicked"/>
            <Button Text="Add" Clicked="OnAddClicked"/>
            <Button Text="Search" Clicked="OnSearchClicked"/>
        </HorizontalStackLayout>

        <!-- BROWSE -->
        <VerticalStackLayout x:Name="BrowseView" Padding="20">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label Text="{Binding Description}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- ADD -->
        <VerticalStackLayout x:Name="AddView" Padding="20" Spacing="10" IsVisible="False">
            <Entry Placeholder="Name" Text="{Binding Name}" />
            <Entry Placeholder="Description" Text="{Binding Description}" />
            <Button Text="Save" Command="{Binding AddItemCommand}" />
        </VerticalStackLayout>

        <!-- SEARCH -->
        <VerticalStackLayout x:Name="SearchView" Padding="20" Spacing="10" IsVisible="False">
            <Entry Placeholder="Search..." Text="{Binding SearchText}" />
            <Button Text="Search" Command="{Binding SearchCommand}" />

            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding Name}" />
                            <Label Text="{Binding Description}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>